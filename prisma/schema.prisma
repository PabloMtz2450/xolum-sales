generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  SALES_MANAGER
  SALES_REP
  CREDIT
  INVENTORY
  AUDITOR
  VIEWER
}

enum CustomerStatus { PROSPECT REVIEW ACTIVE BLOCKED INACTIVE }
enum OpportunityStage { PROSPECT CONTACTED QUALIFIED QUOTED NEGOTIATION APPROVAL WON LOST }
enum OrderStatus { DRAFT VALIDATION CONFIRMED PREPARING DISPATCHED DELIVERED CLOSED CANCELLED }
enum AddressType { FISCAL BILLING BRANCH WAREHOUSE DELIVERY TEMPORARY }
enum InventoryMovementType { RECEIPT RESERVATION RELEASE SHIPMENT ADJUSTMENT TRANSFER }

model Organization {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  memberships   Membership[]
  customers     Customer[]
  products      Product[]
  warehouses    Warehouse[]
  priceLists    PriceList[]
  orders        SalesOrder[]
  opportunities Opportunity[]
  invoicePreparations InvoicePreparation[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  memberships Membership[]
  createdAt   DateTime     @default(now())
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  organization   Organization   @relation(fields: [organizationId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  @@unique([organizationId, userId])
}

model Customer {
  id                String         @id @default(cuid())
  organizationId    String
  code              String
  legalName         String
  tradeName         String?
  rfc               String?
  fiscalPostalCode  String?
  fiscalRegime      String?
  cfdiUse           String?
  status            CustomerStatus @default(PROSPECT)
  paymentTermsDays  Int            @default(0)
  creditLimit       Decimal?
  creditHold        Boolean        @default(false)
  organization      Organization   @relation(fields: [organizationId], references: [id])
  contacts          Contact[]
  addresses         Address[]
  opportunities     Opportunity[]
  orders            SalesOrder[]
  invoicePreparations InvoicePreparation[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  @@unique([organizationId, code])
  @@unique([organizationId, rfc])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  role       String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Address {
  id            String      @id @default(cuid())
  customerId    String
  code          String
  type          AddressType
  label         String
  street        String
  exterior      String?
  interior      String?
  neighborhood  String?
  postalCode    String
  city          String
  state         String
  country       String      @default("MEX")
  latitude      Decimal?
  longitude     Decimal?
  deliveryNotes String?
  customer      Customer    @relation(fields: [customerId], references: [id])
  orders        SalesOrder[]
  @@unique([customerId, code])
}

model Opportunity {
  id             String           @id @default(cuid())
  organizationId String
  customerId     String
  name           String
  stage          OpportunityStage @default(PROSPECT)
  amount         Decimal?
  probability    Int?
  expectedClose  DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id])
  customer       Customer         @relation(fields: [customerId], references: [id])
  quotes         Quote[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Product {
  id             String      @id @default(cuid())
  organizationId String
  sku            String
  name           String
  description    String?
  brand          String?
  category       String?
  gtin           String?
  salesUnit      String
  satUnitCode    String?
  satProductCode String?
  taxRate        Decimal?
  weightKg       Decimal?
  volumeM3       Decimal?
  active         Boolean     @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id])
  stocks         Stock[]
  priceItems     PriceListItem[]
  quoteLines     QuoteLine[]
  orderLines     SalesOrderLine[]
  @@unique([organizationId, sku])
}

model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id])
  stocks         Stock[]
  movements      InventoryMovement[]
  @@unique([organizationId, code])
}

model Stock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  onHand      Decimal   @default(0)
  reserved    Decimal   @default(0)
  inTransit   Decimal   @default(0)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  @@unique([warehouseId, productId])
}

model InventoryMovement {
  id          String                @id @default(cuid())
  warehouseId String
  productId   String
  type        InventoryMovementType
  quantity    Decimal
  reference   String?
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime              @default(now())
}

model PriceList {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  currency       String          @default("MXN")
  active         Boolean         @default(true)
  organization   Organization    @relation(fields: [organizationId], references: [id])
  items          PriceListItem[]
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  productId   String
  unitPrice   Decimal
  minQuantity Decimal   @default(1)
  validFrom   DateTime?
  validTo     DateTime?
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  @@unique([priceListId, productId, minQuantity])
}

model Quote {
  id            String      @id @default(cuid())
  opportunityId String
  number        String
  version       Int         @default(1)
  status        String      @default("DRAFT")
  total         Decimal
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  lines         QuoteLine[]
  createdAt     DateTime    @default(now())
}

model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  productId String
  quantity  Decimal
  unitPrice Decimal
  discount  Decimal @default(0)
  quote     Quote   @relation(fields: [quoteId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model SalesOrder {
  id                String       @id @default(cuid())
  organizationId    String
  customerId        String
  deliveryAddressId String
  number            String
  customerReference String?
  status            OrderStatus  @default(DRAFT)
  currency          String       @default("MXN")
  total             Decimal
  promisedAt        DateTime?
  tmsShipmentId     String?
  tmsSyncStatus     String?
  organization      Organization @relation(fields: [organizationId], references: [id])
  customer          Customer     @relation(fields: [customerId], references: [id])
  deliveryAddress   Address      @relation(fields: [deliveryAddressId], references: [id])
  lines             SalesOrderLine[]
  invoicePreparations InvoicePreparation[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  @@unique([organizationId, number])
}

model SalesOrderLine {
  id        String     @id @default(cuid())
  orderId   String
  productId String
  quantity  Decimal
  unitPrice Decimal
  discount              Decimal    @default(0)
  customerPurchaseOrder String?
  customerPoLine        String?
  customerItemCode      String?
  order                  SalesOrder     SalesOrder @relation(fields: [orderId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])
}


model InvoicePreparation {
  id                  String       @id @default(cuid())
  organizationId      String
  customerId          String
  salesOrderId        String
  version             Int          @default(1)
  status              String       @default("DRAFT")
  cfdiVersion         String       @default("4.0")
  voucherType         String       @default("I")
  series              String?
  currency            String       @default("MXN")
  exchangeRate        Decimal?
  paymentMethod       String
  paymentForm         String?
  exportCode          String       @default("01")
  placeOfIssue        String
  issuerSnapshot      Json
  receiverSnapshot    Json
  globalInformation   Json?
  relatedCfdis        Json?
  complementCode      String?
  complementVersion   String?
  complementPayload   Json?
  addendaRequired     Boolean      @default(false)
  addendaCode         String?
  addendaPayload      Json?
  subtotal            Decimal
  discount            Decimal      @default(0)
  transferredTaxes    Decimal      @default(0)
  withheldTaxes       Decimal      @default(0)
  total               Decimal
  payloadHash         String?
  lockedAt            DateTime?
  lockedBy            String?
  validationErrors    Json?
  fiscalDocumentId    String?
  fiscalSyncStatus    String?
  organization        Organization @relation(fields: [organizationId], references: [id])
  customer            Customer     @relation(fields: [customerId], references: [id])
  salesOrder          SalesOrder   @relation(fields: [salesOrderId], references: [id])
  concepts            FiscalConcept[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  @@unique([salesOrderId, version])
}

model FiscalConcept {
  id                    String             @id @default(cuid())
  invoicePreparationId  String
  orderLineId           String?
  lineNumber            Int
  productServiceCode    String
  internalSku           String?
  customerItemCode      String?
  gtin                  String?
  identificationNumber  String?
  quantity              Decimal
  unitCode              String
  unitName              String?
  description           String
  unitValue             Decimal
  amount                Decimal
  discount              Decimal           @default(0)
  taxObjectCode         String
  customerPurchaseOrder String?
  customerPoLine        String?
  customsInformation    Json?
  propertyAccount       String?
  thirdPartyAccount     Json?
  preparation           InvoicePreparation @relation(fields: [invoicePreparationId], references: [id], onDelete: Cascade)
  taxes                 FiscalConceptTax[]
  @@unique([invoicePreparationId, lineNumber])
}

model FiscalConceptTax {
  id              String        @id @default(cuid())
  fiscalConceptId String
  direction       String
  taxCode         String
  factorType      String
  rateOrQuota     Decimal?
  base            Decimal
  amount          Decimal?
  concept         FiscalConcept @relation(fields: [fiscalConceptId], references: [id], onDelete: Cascade)
}

model FiscalSchemaCatalog {
  id          String   @id @default(cuid())
  code        String
  version     String
  namespace   String
  xsdUrl      String
  xsltUrl     String?
  activeFrom  DateTime?
  activeTo    DateTime?
  sha256      String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  @@unique([code, version])
}

model IntegrationDelivery {
  id             String   @id @default(cuid())
  organizationId String
  system         String
  event          String
  correlationId  String
  idempotencyKey String?
  direction      String
  status         String
  attempts       Int      @default(0)
  payloadHash    String?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([system, idempotencyKey])
}
